# mount point               fstype              device                                                                       flags

# Main Partitions ext4
/system                     ext4        /dev/block/platform/bootdevice/by-name/system              flags=display="System";backup=1;flashimg=1;wipeingui
/vendor                     ext4        /dev/block/platform/bootdevice/by-name/vendor              flags=display="Vendor";backup=1;flashimg=1;wipeingui

# Other Partitions
/recovery                   emmc        /dev/block/platform/bootdevice/by-name/recovery            flags=display="Recovery";backup=1;flashimg=1
/boot                       emmc        /dev/block/platform/bootdevice/by-name/boot                flags=display="Boot";backup=1;flashimg=1
/metadata                   emmc        /dev/block/platform/bootdevice/by-name/metadata            flags=display="Metadata";backup=1;wipeingui
/misc                       emmc        /dev/block/platform/bootdevice/by-name/para                flags=display="Misc";backup=1
/persist                    ext4        /dev/block/platform/bootdevice/by-name/persist             flags=display="Persist";backup=1

/data                       ext4        /dev/block/platform/bootdevice/by-name/userdata            flags=display="Data";wipeingui;backup=1;forceencrypt=/dev/block/platform/bootdevice/by-name/metadata
/cache                      ext4        /dev/block/platform/bootdevice/by-name/cache               flags=display="Cache";wipeingui;backup=1;flashimg=1;wipeduringfactoryreset         
/storage                    ext4        /data/media                                                flags=display="Internal Storage";usermrf;fsflags="bind";backup=1;removable

/dtbo                        emmc      /dev/block/platform/bootdevice/by-name/dtbo              flags=display="DTBO";backup=1;flashimg=1
/preloader_a                 emmc      /dev/block/platform/bootdevice/by-name/preloader_a       flags=display="Preloader_A";backup=1
/preloader_b                 emmc      /dev/block/platform/bootdevice/by-name/preloader_b       flags=display="Preloader_B";backup=1


/protect_f                   ext4      /dev/block/platform/bootdevice/by-name/protect1          flags=display="PROTECT_F";backup=1
/protect_s                   ext4      /dev/block/platform/bootdevice/by-name/protect2          flags=display="PROTECT_S";backup=1
/nvdata                      ext4      /dev/block/platform/bootdevice/by-name/nvdata            flags=display="NVData";backup=1
/nvcfg                       ext4      /dev/block/platform/bootdevice/by-name/nvcfg             flags=display="NVCFG";backup=1
/nvram                       emmc      /dev/block/platform/bootdevice/by-name/nvram             flags=display="NVRAM";backup=1
/persist                     ext4      /dev/block/platform/bootdevice/by-name/persist           flags=display="Persist";backup=1
/persistent                  emmc      /dev/block/platform/bootdevice/by-name/frp               flags=display="Persistent (FRP)";wipeingui;backup=1

# Standard MediaTek based device partitions
/odmdtbo                     emmc        /dev/block/platform/bootdevice/by-name/odmdtbo         flags=display="ODMDTBO";backup=1
/otp                         emmc        /dev/block/platform/bootdevice/by-name/otp             flags=display="OTP";backup=1
/proinfo                     emmc        /dev/block/platform/bootdevice/by-name/proinfo         flags=display="PROINFO";backup=1
/bootloader                  emmc        /dev/block/platform/bootdevice/by-name/lk              flags=display="LK";backup=1
/bootloader2                 emmc        /dev/block/platform/bootdevice/by-name/lk2             flags=display="LK2";backup=1
/logo                        emmc        /dev/block/platform/bootdevice/by-name/logo            flags=display="Logo";backup=1;flashimg=1
/expdb                       emmc        /dev/block/platform/bootdevice/by-name/expdb           flags=display="EXPDB";backup=1
/efuse                       emmc        /dev/block/platform/bootdevice/by-name/efuse           flags=display="EFUSE";backup=1
/seccfg                      emmc        /dev/block/platform/bootdevice/by-name/seccfg          flags=display="SECCFG";backup=1
/tee1                        emmc        /dev/block/platform/bootdevice/by-name/tee1            flags=display="TEE1";backup=1
/tee2                        emmc        /dev/block/platform/bootdevice/by-name/tee2            flags=display="TEE2";backup=1
/mcupmfw                     emmc        /dev/block/platform/bootdevice/by-name/mcupmfw         flags=display="MCUPMFW";backup=1
/md1img                      emmc        /dev/block/platform/bootdevice/by-name/md1img          flags=display="MD1IMG";backup=1
/md1dsp                      emmc        /dev/block/platform/bootdevice/by-name/md1dsp          flags=display="MD1DSP";backup=1
/gz1                         emmc        /dev/block/platform/bootdevice/by-name/gz1             flags=display="GZ1";backup=1
/gz2                         emmc        /dev/block/platform/bootdevice/by-name/gz2             flags=display="GZ2";backup=1
/gpt_main                    emmc        /dev/block/platform/bootdevice/by-name/gpt_main        flags=display="GPT_MAIN";backup=1
/gpt_backup                  emmc        /dev/block/platform/bootdevice/by-name/gpt_backup      flags=display="GPT_BACKUP";backup=1
/spmfw                       emmc        /dev/block/platform/bootdevice/by-name/spmfw           flags=display="SPMFW";backup=1
/boot_para                   emmc        /dev/block/platform/bootdevice/by-name/boot_para       flags=display="Boot Para";backup=1
/loader_ext1                 emmc        /dev/block/platform/bootdevice/by-name/loader_ext1     flags=display="LOADER_EXT1";backup=1
/loader_ext2                 emmc        /dev/block/platform/bootdevice/by-name/loader_ext2     flags=display="LOADER_EXT2";backup=1

# Partitions provided by the device (manufacturer)
/simlock                     ext4        /dev/block/platform/bootdevice/by-name/simlock         flags=display="SIMLOCK";backup=1
/tctpersist                  ext4        /dev/block/platform/bootdevice/by-name/tctpersist      flags=display="TCTPERSIST";backup=1


# External partitions (removable)
/external_sd                 vfat     /dev/block/mmcblk1p1         /dev/block/mmcblk1   flags=display="MicroSD";storage;wipeingui;removable;fsflags="utf8"
/usb_otg                     vfat     /dev/block/sda1              /dev/block/sda       flags=display="USB-OTG";storage;wipeingui;removable;fsflags="utf8"

auto              auto     /devices/platform/externdevice*                        flags=voldmanaged=sdcard1:auto,encryptable=userdata



